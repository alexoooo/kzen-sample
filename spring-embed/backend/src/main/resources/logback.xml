<?xml version="1.0" encoding="UTF-8"?>
<!-- The host owns the logging backend: console only, its own pattern. Without this file Spring Boot's
     LogbackLoggingSystem picks up kzen-auto-jvm.jar!/logback.xml and the host inherits kzen's file appender
     (HS02 G4). -->
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="tech.kzen" level="INFO"/>
    <logger name="io.ktor" level="INFO"/>
    <logger name="org.apache.tomcat" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="console"/>
    </root>
</configuration>
